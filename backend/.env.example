# Copy to backend/.env and fill in.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Option A: free open-source model via Groq (https://console.groq.com) ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=gsk_...

# Other OpenAI-compatible endpoints work the same way, e.g.:
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1   (no key needed)

# --- Option B: Claude (https://platform.claude.com) ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...

# Admin: emails (comma-separated) that use Admin login, and a one-time password used to
# create the admin account at startup if it doesn't exist. Change it in Settings afterwards.
ADMIN_EMAILS=mhatre.anushka.work@gmail.com
ADMIN_INITIAL_PASSWORD=choose-a-strong-password

# --- Multi-model routing (open-source models only; see docs/llm-routing-strategy.md) ---
# Small tier for simple messages, large tier for complex ones (comma-separated, same provider).
# LLM_SMALL_MODELS=openai/gpt-oss-20b
# LLM_LARGE_MODELS=openai/gpt-oss-120b
# Extra providers for failover: copy llm_pool.example.json to llm_pool.json and add their keys here, e.g.
# OPENROUTER_API_KEY=...
# ALLOWED_MODEL_LICENSES=Apache-2.0,MIT   # models under other licences (e.g. Llama, Gemma) are skipped
# LLM_ROUTING=true      # false = always use the large tier
# LLM_FASTPATH=true     # false = never answer by rules (water, "yes", summaries, saved foods)

# Optional
# SHOW_LLM_ERRORS=true          # dev only: show the real LLM error instead of "servers are down"
# LLM_EFFORT=low                 # reasoning effort
# CHAT_HISTORY_MESSAGES=12       # past messages sent as context
# DATABASE_URL=sqlite:///./macro_tracker.db   # keep SQLite locally; production's Neon URL is set in Render
# TARGET_DATABASE_URL=postgresql://...        # only for scripts/copy_to_postgres.py (docs/deployment.md)
# COOKIE_SECURE=true             # set when served over HTTPS
# BREVO_API_KEY=...              # password-reset emails; without it, development prints the reset link to the log
# EMAIL_FROM=you@example.com     # sender verified in Brevo
# JOIN_MODE=open                 # open: anyone can sign up; waitlist: Join opens the form, new accounts need an approved email
# LAUNCHER_ORIGIN=               # the always-on welcome site's origin (production: https://tandurust-app.onrender.com)
# WAITLIST_ALERT_EMAIL=          # where new waitlist sign-ups are announced (default: the admin email)
# PUBLIC_APP_URL=http://localhost:5173   # base of links in emails (default in development)
# SENTRY_DSN=https://...ingest.sentry.io/...   # optional error reports (docs/deployment.md); nothing personal is sent
# AI_DAILY_MESSAGE_LIMIT=20      # AI-answered messages per user per local day (0 = unlimited)
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com   # Continue with Google (Google Cloud → Google Auth Platform → Clients); empty hides the button
