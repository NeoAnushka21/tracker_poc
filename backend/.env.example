# Copy to backend/.env and fill in.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Option A: free open-source model via Groq (https://console.groq.com) ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=gsk_...

# Other OpenAI-compatible endpoints work the same way, e.g.:
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1   (no key needed)

# --- Option B: Claude (https://platform.claude.com) ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...

# Admin: emails (comma-separated) that use Admin login, and a one-time password used to
# create the admin account at startup if it doesn't exist. Change it in Settings afterwards.
ADMIN_EMAILS=mhatre.anushka.work@gmail.com
ADMIN_INITIAL_PASSWORD=choose-a-strong-password

# Optional
# SHOW_LLM_ERRORS=true          # dev only: show the real LLM error instead of "servers are down"
# LLM_EFFORT=low                 # reasoning effort
# CHAT_HISTORY_MESSAGES=12       # past messages sent as context
# DATABASE_URL=sqlite:///./macro_tracker.db
# COOKIE_SECURE=true             # set when served over HTTPS
